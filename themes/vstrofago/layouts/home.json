{{- $sections := site.Params.mainSections | default (slice "posts") -}}
{{- $pages := where site.RegularPages "Section" "in" $sections -}}
[
{{- range $i, $p := $pages }}
{{- if $i }},{{ end }}
{"title":{{ $p.Title | jsonify }},"permalink":{{ $p.RelPermalink | jsonify }},"date":{{ ($p.Date | time.Format "2006-01-02") | jsonify }},"summary":{{ ($p.Summary | plainify) | jsonify }},"tags":{{ with $p.Params.tags }}{{ . | jsonify }}{{ else }}[]{{ end }},"content":{{ ($p.Plain | truncate 1200) | jsonify }}}
{{- end }}
]
